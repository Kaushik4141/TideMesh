# ==============================================================================
# TideMesh API — Environment Variables Template
# ==============================================================================

# Neon PostgreSQL Connection URL (Pooled / Serverless)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-summer-field-b4mr995l-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Neon PostgreSQL Direct Connection URL (Unpooled - required for migrations and DDL)
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:YOUR_PASSWORD@ep-summer-field-b4mr995l.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Neon Branch Name
NEON_BRANCH="production"

# Environment Mode: development | test | production
NODE_ENV="development"

# Server Port (for local Node server)
PORT=3000

# Base URL
API_BASE_URL="http://localhost:3000"

# River map: bounded OSM viewport mapping works without these settings.
# Configure both values only when a licensed national vector tile dataset exists.
RIVER_VECTOR_TILE_URL=""
RIVER_VECTOR_SOURCE_LAYER=""
RIVER_ATTRIBUTION=""
OVERPASS_API_URL="https://overpass-api.de/api/interpreter"

# Operations persistence/authentication. Keep tokens in private environment files.
OPERATIONS_DATA_DIR=""
OPERATIONS_AUTH_TOKEN=""
OPERATIONS_AUTH_USER_JSON=""
OPERATIONS_PUBLISHER_TOKEN=""

# Safety switch: false/unset prevents Docker/SFINCS workloads on a laptop.
ENABLE_SFINCS_LOCAL_RUNNER="false"
SFINCS_DOCKER_CPUS="2"
SFINCS_DOCKER_MEMORY="4g"
